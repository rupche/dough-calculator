    country:'country', sdboule:'sdboule', opencrumb:'crumb', wholewheat:'wheat', sdsandwich:'sliceb', sdpizza:'sdpizza'
  };
  var METHOD_ICON = { steel:'steel', pizzaoven:'pizzaoven', tray:'tray', skillet:'skillet', grill:'grill', dutch:'dutch', stonesteam:'stonesteam', tin:'tin', sheet:'sheet' };
  var ACC_ICON = { 'Bake-day timeline':'clock', 'Feed your starter':'jar', 'Water temperature':'thermo', 'Is it ready?':'check', 'Troubleshooting':'help' };
  var OPT_ICON = {
    leaven:{ starter:'jar', instant:'packet', active:'granules', fresh:'cube' },
    starterType:{ white:'jar-white', whole:'jar-whole', rye:'jar-rye', stiff:'jar-stiff' },
    incl:{ none:'none', seeds:'seeds', walnuts:'walnut', olives:'olive', cheese:'cheese', fruit:'fruit', custom:'plus' },
