    sdMode:{ room:'sun', retard:'snow' },
    planMode:{ bake:'oven', mix:'bowl' },
    friction:{ '0':'hand', '8':'mixer', '12':'hook' },
    methodSel:METHOD_ICON,
    sgFlour:{ whole:'jar-whole', rye:'jar-rye', white:'jar-white' }
  };
  var PICKERS = [['leaven','Leavening'],['starterType','Starter type'],['incl','Mix-in'],['vessel','Banneton or tin'],['sdMode','After shaping'],['planMode','Plan around'],['friction','Mixing'],['methodSel','Baking method'],['sgFlour','Starter flour']];
  function icon(id, cls){
    return '<svg class="' + (cls || 'ic') + '" viewBox="0 0 64 64" aria-hidden="true" focusable="false">' + (ICONS[id] || ICONS.bread) + '</svg>';
  }
  Array.prototype.forEach.call(document.querySelectorAll('[data-ic]'), function(el){
    el.innerHTML = icon(el.getAttribute('data-ic'), 'ic ic-sm');
  });
  function renderPickers(){
    PICKERS.forEach(function(pk){
      var sel = $(pk[0]), box = document.getElementById('pk-' + pk[0]);
      if (!box){
        box = document.createElement('div');
        box.className = 'picker'; box.id = 'pk-' + pk[0];
        box.setAttribute('role', 'group'); box.setAttribute('aria-label', pk[1]);
        sel.parentNode.insertBefore(box, sel);
        sel.hidden = true;
        box.addEventListener('click', function(e){
          var b = e.target.closest('button[data-v]');
          if (!b) return;
          sel.value = b.getAttribute('data-v');
          sel.dispatchEvent(new Event('change', { bubbles:true }));
        });
      }
      var opts = Array.prototype.slice.call(sel.options);
      var sig = opts.map(function(o){ return o.value; }).join('|');
      if (box.getAttribute('data-sig') !== sig){
        box.setAttribute('data-sig', sig);
        box.innerHTML = opts.map(function(o){
          return '<button type="button" class="pchip" data-v="' + o.value + '" aria-pressed="false">' + icon((OPT_ICON[pk[0]] || {})[o.value] || 'plus') + '<span>' + o.textContent + '</span></button>';
        }).join('');
      }
      Array.prototype.forEach.call(box.children, function(b){
        b.setAttribute('aria-pressed', String(b.getAttribute('data-v') === sel.value));
      });
    });
  }

  var STYLE_METHOD = {
    neapolitan:'steel', newyork:'steel', pan:'tray', taglio:'tray',
    sandwich:'tin', boule:'dutch', baguette:'stonesteam', ciabatta:'stonesteam', focaccia:'sheet',
    country:'dutch', sdboule:'dutch', opencrumb:'dutch', wholewheat:'dutch', sdsandwich:'tin', sdpizza:'steel'
  };
  var METHODS = {
    pizza:[
      { id:'steel', name:'Home oven, steel or stone', temp:'250–290 °C', preheat:60, time:'5–9 min', mul:1,
        setup:['Put the steel or stone on the upper-middle rack and heat it for 45–60 minutes at your oven’s maximum.','Launch on a peel dusted with semolina or flour, or on parchment you slide out after the first minute.'],
        tips:['A steel passes heat faster than a stone, so it browns the base quicker and gives more leopard spots.','For more colour on top, switch to the grill for the last 1–2 minutes with the pizza still on the steel.','Keep toppings light. A wet pizza does not cook through before the base burns.'],
        watch:['Open the door as little as possible. Every opening drops the heat.','Always heat a stone together with the oven. A cold stone can crack in a hot oven.'] },
      { id:'pizzaoven', name:'Outdoor pizza oven', temp:'400–480 °C', preheat:30, time:'60–120 seconds', mul:0.2,
        setup:['Heat until the stone floor reads 400 °C or more on an infrared thermometer. Gas takes 20–30 minutes and wood 45–60.','Keep a small live flame at the back and sweep the floor clean before each pizza.'],
        tips:['Turn the pizza a quarter every 15–20 seconds so the rim cooks evenly.','Launch fast from a well-floured peel. Dough sticks the longer it waits.','Use less sugar and oil in the dough. At this heat they burn before the crumb cooks.'],
        watch:['The floor can run hotter than the dome. If the base scorches, wait a minute between pizzas.','Use a long peel and heat-proof gloves.'] },
      { id:'tray', name:'Baking tray or sheet pan', temp:'230–250 °C', preheat:20, time:'10–15 min', mul:1.6,
        setup:['Turn a heavy tray upside down on the lowest rack and preheat it for 20 minutes.','Bake on parchment on the hot tray, or oil a second tray and bake in it for a fried base.'],
        tips:['Use the lowest rack for the base, then move up for the last 2–3 minutes to colour the top.','A heavy aluminium tray conducts heat far better than a thin one.','Oil the tray generously for a crisp, golden underside.'],
        watch:['A cold tray gives a pale, soft base.','Parchment gets brittle above about 230 °C, so keep it off the oven walls and element.'] },
      { id:'skillet', name:'Cast-iron skillet', temp:'230–250 °C', preheat:10, time:'8–12 min', mul:1.4,
        setup:['Heat the skillet on medium-high for 2 minutes, add a little oil and press the dough in.','Cook the base 2–3 minutes on the hob, add toppings, then finish in a hot oven or under the grill.'],
        tips:['The pan sets a crisp base while the oven finishes the top.','A thin dough gives a crisp crust. A thicker one gives a deep-dish crust.','Rest the pizza 2 minutes before lifting it out so the base does not steam.'],
        watch:['The handle stays very hot. Cover it with a mitt.','Do not put a cold pan on a very high flame.'] },
      { id:'grill', name:'Charcoal or gas grill', temp:'260–290 °C', preheat:15, time:'3–6 min', mul:0.7,
        setup:['Heat the grill with the lid closed, then clean and oil the grates.','Stretch the base thin and have every topping ready before the dough goes on.'],
        tips:['Grill the first side with the lid open until it puffs and marks, 1–2 minutes.','Flip, add toppings quickly, close the lid and finish over indirect heat.','A pizza stone on the grill gives a more even base.'],
        watch:['Keep toppings light so the base does not stay raw.','Never leave the grill unattended when fat can flare up.'] }
    ],
    bread:[
      { id:'dutch', name:'Dutch oven', temp:'230–250 °C', preheat:45, time:'40–50 min for a boule', mul:1,
        setup:['Put the pot and lid in the cold oven and preheat for 45–60 minutes.','Score the loaf, then lower it in on a parchment sling.'],
        tips:['Keep the lid on for the first 20–25 minutes. The trapped steam gives oven spring and a glossy crust.','Remove the lid, lower the heat by 15–20 °C and bake until deep brown.','A lidded pot of about 4–5 litres suits a 900 g loaf.'],
        watch:['Check the maximum temperature of the lid knob. Many plastic knobs fail above 200–230 °C.','The pot and lid are extremely hot. Use thick mitts.'] },
      { id:'stonesteam', name:'Stone or steel with steam', temp:'230–250 °C', preheat:45, time:'20–35 min', mul:0.9,
        setup:['Preheat the stone or steel for 45–60 minutes on the middle rack, with an empty metal tray on the lowest rack.','Slide the loaf on with parchment, pour about 250 ml of boiling water into the hot tray and close the door fast.'],
        tips:['Take the steam tray out after 15 minutes so the crust can dry and crisp.','Ice cubes in the hot tray are a gentler alternative to boiling water.','Slide thin loaves like baguettes on a floured cloth or board and transfer with a peel.'],
        watch:['Never spray water at a glass oven door. It can crack.','Steam burns. Pour away from your face and arms.'] },
      { id:'tin', name:'Loaf tin', temp:'190–220 °C', preheat:15, time:'30–45 min', mul:0.85,
        setup:['Grease the tin well or line it with parchment. Fill it to about 70–75% before the final proof.','Bake on the middle rack. No preheated stone is needed.'],
        tips:['Lean loaves are done at 96–98 °C inside, enriched ones at 90–93 °C.','Tip the loaf out of the tin after 5–10 minutes so the sides do not go soft.','Brush the top with butter or milk after baking for a softer crust.'],
        watch:['Dark metal tins brown faster. Lower the heat by 10 °C or tent with foil if the top darkens early.','Glass tins hold heat, so take the loaf out a little earlier.'] },
      { id:'sheet', name:'Baking sheet', temp:'220–240 °C', preheat:30, time:'20–35 min', mul:0.85,
        setup:['Preheat a heavy sheet upside down, or bake on parchment on a cold sheet if yours is thin.','Put a metal tray with boiling water on the rack below for steam.'],
        tips:['Cover with a large steel bowl for the first 15 minutes to trap steam, then uncover.','Expect a lighter, thinner crust than a Dutch oven gives.','Shape tighter and use a little less water, because the dough has no walls to hold it up.'],
        watch:['A thin sheet warps and spits at high heat.','Do not lay foil on the dough. It sticks.'] },
      { id:'skillet', name:'Cast-iron skillet', temp:'220–240 °C', preheat:20, time:'20–35 min', mul:0.8,
        setup:['Heat the pan in the oven for 20 minutes, add oil and lower the dough in.','For a boule, cover with a second pan or a lid for the first 15–20 minutes.'],
        tips:['A generous layer of oil fries the base for focaccia.','A pan with high walls gives a soft, tall loaf, which suits wetter doughs.','Rest the bread for 5 minutes, then lift it out so the base does not steam.'],
        watch:['The pan stays hot long after baking.','Do not use nonstick pans at these temperatures.'] }
    ]
  };
  var UNIVERSAL = {
    pizza:[
      'Use an oven thermometer. Many home ovens run 10–25 °C away from the dial.',
      'Fan oven: lower the temperature by 15–20 °C or check 2 minutes early. A strong fan dries the top before the base is done.',
      'Rack position matters. Lower gives a crisper base and higher gives more top colour.'
    ],
    bread:[
      'Use an oven thermometer. Many home ovens run 10–25 °C away from the dial.',
      'Fan oven: lower the temperature by 15–20 °C or check 5–10 minutes early. A strong fan dries the crust before the loaf rises.',
      'Rack position matters. Lower gives a crisper base, middle gives an even bake and higher gives more top colour.',
      'Bake by crust colour and inside temperature, not by the clock alone.',
      'Let the loaf cool for about an hour. The crumb is still setting.'
    ]
  };
  function methodGroup(st){ return (state.cat === 'pizza' || st.id === 'sdpizza') ? 'pizza' : 'bread'; }
  function findMethod(list, id){
    for (var i = 0; i < list.length; i++){ if (list[i].id === id) return list[i]; }
    return null;
  }
  function defMethod(st){
    var list = METHODS[methodGroup(st)];
    return findMethod(list, STYLE_METHOD[st.id]) || list[0];
  }
  function curMethod(){
    var st = currentStyle();
    return findMethod(METHODS[methodGroup(st)], state.method) || defMethod(st);
  }
  function methodBlock(){
    var st = currentStyle(), g = methodGroup(st), list = METHODS[g], cm = curMethod();
    var li = function(t){ return '<li>' + L(t) + '</li>'; };
    var h = '<div class="mblock"><div><p class="eyebrow">Baking method</p><h3 class="mh">Tips for how you bake</h3></div>';
    h += '<div class="styles" role="group" aria-label="Baking method">' + list.map(function(m){
      return '<button type="button" class="chip" data-method="' + m.id + '" aria-pressed="' + (m.id === cm.id) + '"><span class="thumb">' + icon(METHOD_ICON[m.id]) + '</span><span class="txt"><span class="n">' + m.name + '</span><span class="m">' + L(m.temp) + '</span></span></button>';
    }).join('') + '</div>';
    h += '<dl class="mstats"><div><dt>Oven</dt><dd>' + L(cm.temp) + '</dd></div><div><dt>Preheat</dt><dd>' + cm.preheat + ' min</dd></div><div><dt>Typical time</dt><dd>' + cm.time + '</dd></div></dl>';
    h += '<div class="cols"><div><h3>Setup</h3><ol>' + cm.setup.map(li).join('') + '</ol></div>';
    h += '<div><h3>Tips</h3><ul>' + cm.tips.map(li).join('') + '</ul></div>';
    h += '<div><h3>Watch out</h3><ul>' + cm.watch.map(li).join('') + '</ul></div></div>';
    h += '<div><h3 class="lbl3">For any oven</h3><ul class="univ">' + UNIVERSAL[g].map(li).join('') + '</ul></div></div>';
    return h;
  }
  function renderMethodSelect(){
    var st = currentStyle(), cm = curMethod();
    $('methodSel').innerHTML = METHODS[methodGroup(st)].map(function(m){ return '<option value="' + m.id + '">' + m.name + '</option>'; }).join('');
    $('methodSel').value = cm.id;
  }
  function pickMethod(id){
    state.method = id;
    renderNotes();
    updateResults();
  }

  var READY = [
    { t:'Starter is ripe', b:['It has doubled or more in 4–8 hours and the top is domed or just starting to dip.','Bubbles run through the jar, not only on top. It smells sweet and yeasty rather than sharp.','Use it at its peak. A fallen, very sour starter makes a slower, weaker dough.'] },
    { t:'Bulk fermentation is done', b:['The dough is up 50–75% in a straight-sided container. Mark the start level with a band.','The surface is domed with bubbles, and the dough jiggles when you shake the bowl.','Treat the clock as a guide. Warm kitchens finish earlier.'] },
    { t:'Proofed and ready to bake', b:['Flour a finger and poke the dough 1 cm deep.','<b>Springs back slowly and partly:</b> ready.','<b>Springs back fast:</b> needs more time. <b>Stays dented:</b> overproofed, so bake right away.','A cold-retarded loaf is ready straight from the fridge.'] },
    { t:'Baked through', b:['The crust is deep brown and the base sounds hollow when tapped.','The inside reads 96–98 °C on a probe thermometer.','Cool on a rack for at least an hour. The crumb is still setting.'] }
  ];
  var TROUBLE = [
    { t:'Flat loaf that spreads', b:'Likely overproofed, a weak starter, or dough too wet for the flour. Shorten the bulk, use the starter at its peak, lower hydration by 3–5 points and shape tighter.' },
    { t:'Dense, tight crumb', b:'Likely underproofed or a sluggish starter. Let the bulk reach a 50–75% rise, feed the starter twice before baking and keep the dough warmer.' },
    { t:'Too sour', b:'Long cold retards, stiff or old starters and high whole-grain shares push sourness. Use a liquid starter fed at 1 : 5, retard 8–10 hours and cut the whole grain.' },
    { t:'Not sour enough', b:'Short, warm fermentations give a mild loaf. Try a 12–16 hour retard, 15–20% whole wheat or rye, or a stiffer starter.' },
    { t:'Gummy crumb', b:'The loaf was cut hot, underbaked, or too wet. Bake until the inside reaches 96–98 °C and cool for a full hour.' },
    { t:'Pale or thick crust', b:'The oven was too cool or the loaf had no steam. Preheat the Dutch oven for 45–60 minutes and uncover for the final 20–25 minutes.' },
    { t:'No ear, loaf bursts at the side', b:'Score 0.5–1 cm deep at about 30–45° and shape tighter. A cold loaf scores more cleanly.' },
    { t:'Sticky, slack dough', b:'Hydration is high for your flour. Wet your hands, fold more often, use stronger flour or lower hydration by 3–5 points.' }
  ];
  var SAVE_KEYS = ['cat','styleId','leaven','starterHyd','starterType','pieces','weight','hydration','salt','fat','sugar','hours','temp','incl','inclPct','scaleBy','flourTotal','sdMode','autolyse','retardH','bakeMin','planMode','planTime','roomT','flourT','starterT','friction','feedRatio','keep','method'].concat(FLOUR_KEYS);

  try {
    var su = localStorage.getItem('dough-units');
    if (su === 'metric' || su === 'imperial') state.units = su;
  } catch (e0) {}

  $('incl').innerHTML = '<option value="none">None</option>' + Object.keys(INCL).map(function(k){ return '<option value="' + k + '">' + INCL[k].name + '</option>'; }).join('');
  $('vessel').innerHTML = VESSELS.map(function(v){ return '<option value="' + v.id + '">' + v.name + '</option>'; }).join('');

  function L(t){
    if (state.units !== 'imperial') return t;
    return t.replace(/(\d+)(?:–(\d+))? °C/g, function(m, a, b){
      var f = function(x){ return Math.round((x*9/5 + 32)/5)*5; };
      return f(+a) + (b ? '–' + f(+b) : '') + ' °F';
    });
  }
  function wParts(g){
    if (state.units === 'imperial'){
      var oz = g/G_OZ;
      if (oz >= 16){ var lb = Math.floor(oz/16); return { n: lb + ' lb ' + (oz - 16*lb).toFixed(1), u:'oz' }; }
      return { n: oz < 1 ? oz.toFixed(2) : oz.toFixed(1), u:'oz' };
    }
    return { n: fmtG(g), u:'g' };
  }
  function fmtW(g){ var p = wParts(g); return p.n + ' ' + p.u; }
  function tempText(c){ return state.units === 'imperial' ? Math.round(c*9/5 + 32) + ' °F' : c + ' °C'; }
  function fmtT(c){
    return state.units === 'imperial' ? (Math.round((c*9/5 + 32)*10)/10) + ' °F' : (Math.round(c*10)/10) + ' °C';
  }
  function fromBase(kind, v){
    if (state.units !== 'imperial') return v;
    if (kind === 'w') return Math.round(v/G_OZ*10)/10;
    if (kind === 't') return Math.round(v*9/5 + 32);
    return v;
  }
  function toBase(kind, v){
    if (state.units !== 'imperial') return v;
    if (kind === 'w') return v*G_OZ;
    if (kind === 't') return (v - 32)*5/9;
    return v;
  }
  function fieldVal(el){
    var k = el.getAttribute('data-kind'), v = state[el.id];
    return k ? fromBase(k, v) : v;
  }
  function limit(el, which){
    var a = el.getAttribute('data-' + which);
    if (a !== null) return Number(a);
    return Number(which === 'lo' ? el.min : el.max);
  }
  function pad2(n){ return (n < 10 ? '0' : '') + n; }
  function clock(m){ var x = ((Math.round(m) % 1440) + 1440) % 1440; return pad2(Math.floor(x/60)) + ':' + pad2(x % 60); }
  function parseTime(t){ var p = String(t || '09:00').split(':'); return (+p[0])*60 + (+p[1] || 0); }
  function fmtH(h){ return (Math.round(h*2)/2) + ' h'; }

  function feedPlan(c){
    if (!c.starter) return null;
    var r = Number(state.feedRatio), hy = state.starterHyd/100;
    var keep = Math.max(0, Number(state.keep) || 0);
    var need = c.starter.sw + keep;
    var unit = need/(1 + r + r*hy);
    var baseH = { 1:4, 2:6, 5:8, 10:12 }[r] || 8;
    var ripe = clamp(Math.round(baseH*Math.pow(2, (24 - state.roomT)/10)*2)/2, 2, 24);
    return { need:need, recipe:c.starter.sw, keep:keep, seed:unit, flour:unit*r, water:unit*r*hy, ripe:ripe };
  }

  function renderExtras(c){
    var s = state, sd = s.cat === 'sourdough', np = s.cat !== 'pizza', imp = s.units === 'imperial';
    Array.prototype.forEach.call(document.querySelectorAll('.usuf-w'), function(el){ el.textContent = imp ? 'oz' : 'g'; });
    Array.prototype.forEach.call(document.querySelectorAll('.usuf-t'), function(el){ el.textContent = imp ? '°F' : '°C'; });
    Array.prototype.forEach.call(document.querySelectorAll('#unitSwitch button'), function(b){
      b.setAttribute('aria-pressed', String(b.getAttribute('data-unit') === s.units));
    });
    $('flourTotRow').hidden = s.scaleBy !== 'flour';
    $('weightField').hidden = s.scaleBy === 'flour';
    $('vesselRow').hidden = !np;
    var vs = null;
    VESSELS.forEach(function(v){ if (v.id === s.vessel) vs = v; });
    $('useVessel').hidden = !(vs && vs.g);
    if (vs && vs.g) $('useVessel').textContent = 'Use ' + fmtW(vs.g) + ' for 1 piece';
    $('inclGrp').hidden = !np;
    $('inclAmt').hidden = s.incl === 'none';
    $('inclHint').textContent = s.incl === 'none' ? '' : L(INCL[s.incl].hint);
    $('starterTypeRow').hidden = s.leaven !== 'starter';
    $('starterProfile').textContent = (STARTER_TYPES[s.starterType] || STARTER_TYPES.white).note;
    var tools = s.page === 'tools' && sd;
    var guide = s.page === 'starter';
    var curPage = tools ? 'tools' : guide ? 'starter' : 'recipe';
    $('sdTools').hidden = !tools;
    $('starterGuide').hidden = !guide;
    $('mainGrid').hidden = tools || guide;
    $('notes').hidden = tools || guide;
    $('tabs').hidden = tools || guide;
    $('pickSec').hidden = guide;
    Array.prototype.forEach.call(document.querySelectorAll('#pageTabs button'), function(b){
      b.setAttribute('aria-pressed', String(b.getAttribute('data-page') === curPage));
    });
    $('retardField').hidden = s.sdMode !== 'retard';
    renderMethodSelect();
    renderPickers();
    if (tools){
      $('sdStripText').textContent = currentStyle().name + ' \u00b7 ' + s.pieces + ' \u00d7 ' + fmtW(c.each) + ' \u00b7 ' + s.hydration + '% hydration';
      renderSd(c);
    }
    if (guide) renderGuide();
    if (fer.open) renderFer();
  }

  function renderSd(c){
    var s = state, st = currentStyle();
    var ready = '', trouble = '';
    READY.forEach(function(r){ ready += '<details><summary>' + r.t + '</summary><div>' + r.b.map(function(x){ return '<span>' + L(x) + '</span>'; }).join('') + '</div></details>'; });
    TROUBLE.forEach(function(r){ trouble += '<details><summary>' + r.t + '</summary><div><span>' + L(r.b) + '</span></div></details>'; });
    $('readyList').innerHTML = ready;
    $('troubleList').innerHTML = trouble;
    if (s.leaven !== 'starter'){
      var msg = '<p class="note2">Choose Sourdough starter under Leavening to use this.</p>';
      $('tlList').innerHTML = ''; $('tlSummary').textContent = 'Choose Sourdough starter under Leavening to see the timeline.';
      $('feedOut').innerHTML = msg; $('waterOut').innerHTML = msg;
      return;
    }
    var fp = feedPlan(c);

    /* feeding */
    var f = '<dl class="kv">' +
      '<dt>Ripe starter for this dough</dt><dd>' + fmtW(fp.recipe) + '</dd>' +
      '<dt>Plus keep-back</dt><dd>' + fmtW(fp.keep) + '</dd>' +
      '<dt>Old starter (seed)</dt><dd class="big">' + fmtW(fp.seed) + '</dd>' +
      '<dt>Flour</dt><dd class="big">' + fmtW(fp.flour) + '</dd>' +
      '<dt>Water</dt><dd class="big">' + fmtW(fp.water) + '</dd>' +
      '<dt>Ripe in about</dt><dd>' + fmtH(fp.ripe) + ' at ' + tempText(s.roomT) + '</dd></dl>' +
      '<p class="note2">Makes ' + fmtW(fp.need) + ' in total. Mix, cover loosely and use it when it has doubled and domed.</p>';
    $('feedOut').innerHTML = f;

    /* water temperature */
    var hasSt = true, k = 4;
    var sum = Number(s.roomT) + Number(s.flourT) + Number(s.starterT) + Number(s.friction);
    var w = k*s.temp - sum;
    $('tempSub').textContent = 'Target dough temperature ' + tempText(s.temp) + ', set by the Dough temperature slider.';
    var advice = '';
    if (w < 3) advice = '<p class="note2 bad">Very cold. Use ice water, and check whether the flour or room can be cooler or the target warmer.</p>';
    else if (w > 38) advice = '<p class="note2 bad">Too hot. Water above about 38 °C harms the starter. Lower the dough temperature or warm the flour a little.</p>';
    else advice = '<p class="note2">Use this water when you mix the dough.</p>';
    if (state.units === 'imperial') advice = advice.replace('38 °C', '100 °F');
    $('waterOut').innerHTML = '<dl class="kv"><dt>Water to use</dt><dd class="big">' + fmtT(w) + '</dd></dl>' + advice;

    /* timeline */
    var A = Math.max(0, Number(s.autolyse) || 0), B = s.hours*60;
    var folds = B >= 300 ? 4 : B >= 150 ? 3 : B >= 60 ? 2 : 0;
    folds = Math.min(folds, Math.floor(B*0.6/30));
    var proof = clamp(Math.round(90/Math.pow(2, (s.temp - 22)/10)/5)*5, 45, 150);
    var retard = s.sdMode === 'retard';
    var rest = 20, tail = retard ? s.retardH*60 : proof;
    var D = A + B + rest + tail;
    var plan = parseTime(s.planTime);
    var t0 = s.planMode === 'bake' ? plan - D : plan;
    var tAdd = t0 + A, tShape = tAdd + B, tFinal = tShape + rest, tBake = tFinal + tail;
    var pizza = st.id === 'sdpizza', tin = st.id === 'sdsandwich';
    var steps = [];
    steps.push({ t:tAdd - fp.ripe*60, a:'Feed the starter', b:fmtW(fp.seed) + ' old starter + ' + fmtW(fp.flour) + ' flour + ' + fmtW(fp.water) + ' water. Ripe in about ' + fmtH(fp.ripe) + '.' + (function(){ var m = (((Math.round(tAdd - fp.ripe*60) % 1440) + 1440) % 1440); return m < 330 ? ' This falls overnight. A 1 : 10 feed before bed ripens by morning.' : ''; })() });
    if (A > 0) steps.push({ t:t0, a:'Autolyse', b:'Mix ' + fmtW(c.addFlour) + ' flour with ' + fmtW(c.addWater) + ' water until no dry flour remains. Rest ' + A + ' min.' });
    steps.push({ t:tAdd, a:A > 0 ? 'Add starter and salt' : 'Mix the dough', b: (A > 0 ? '' : fmtW(c.addFlour) + ' flour, ' + fmtW(c.addWater) + ' water, ') + fmtW(c.starter.sw) + ' starter and ' + fmtW(c.salt) + ' salt. Water at ' + fmtT(w) + '.', key:true });
    for (var i = 1; i <= folds; i++){
      var extra = (i === folds && s.incl !== 'none') ? ' Add the ' + INCL[s.incl].short.toLowerCase() + ' now.' : '';
      steps.push({ t:tAdd + i*30, a:'Stretch and fold ' + i + ' of ' + folds, b:'Four folds around the bowl.' + extra });
    }
    steps.push({ t:tShape, a:'Bulk is done', b: pizza ? 'Dough is up 50–75% and domed. Divide into balls and cover.' : 'Dough is up 50–75% and domed. Pre-shape and rest ' + rest + ' min.' });
    if (!pizza) steps.push({ t:tFinal - 0.001, a:'Final shape', b: tin ? 'Shape and place in the tin, seam down.' : 'Shape tightly and place seam up in a floured banneton.' });
    if (retard) steps.push({ t:tFinal, a:'Into the fridge', b:'Cover and chill for ' + s.retardH + ' h.', key:true });
    else steps.push({ t:tFinal, a:'Final proof', b:proof + ' min at room temperature. Use the poke test.', key:true });
    var cm = curMethod(), dm = defMethod(st);
    var bm = Math.max(2, Math.round(s.bakeMin * cm.mul / dm.mul));
    var bmLabel = bm <= 2 ? '1\u20132' : String(bm);
    steps.push({ t:tBake - cm.preheat, a:'Preheat the oven', b:cm.name + '. Heat to ' + L(cm.temp) + ' for about ' + cm.preheat + ' minutes.' });
    steps.push({ t:tBake, a:'Bake', b: bmLabel + ' min. ' + (cm.id === dm.id ? L(st.bake) : 'See the baking method tips for ' + cm.name.toLowerCase() + '.'), key:true });
    steps.push({ t:tBake + bm, a:'Out of the oven', b: pizza ? 'Rest for 1 minute, then slice.' : 'Cool on a rack for 1 hour before cutting.' });
    steps.forEach(function(x, ix){ x.i = ix; });
    steps.sort(function(x, y){ return x.t - y.t || x.i - y.i; });
    var first = steps[0].t, dayStart = Math.floor(first/1440)*1440;
    $('tlList').innerHTML = steps.map(function(x){
      return '<li' + (x.key ? ' class="key"' : '') + '><span class="when">' + clock(x.t) + '<small>Day ' + (Math.floor((x.t - dayStart)/1440) + 1) + '</small></span>' +
        '<span class="what"><b>' + x.a + '</b><span>' + x.b + '</span></span></li>';
    }).join('');
    var dBake = Math.floor((tBake - dayStart)/1440) + 1;
    $('tlSummary').textContent = 'First step Day 1 at ' + clock(first) + '. Bake Day ' + dBake + ' at ' + clock(tBake) + '. Ready to cut at ' + clock(tBake + bm + (pizza ? 1 : 60)) + '.';
  }

  /* saved recipes */
  var storeOK = true;
  function readSaved(){
    try {
      var r = JSON.parse(localStorage.getItem('dough-recipes') || '[]');
      return Array.isArray(r) ? r : [];
    } catch (e) { storeOK = false; return []; }
  }
  function writeSaved(a){
    try { localStorage.setItem('dough-recipes', JSON.stringify(a)); return true; }
    catch (e) { storeOK = false; return false; }
  }
  function esc(t){ return String(t).replace(/[&<>"]/g, function(ch){ return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[ch]; }); }
  function renderSaved(){
    var a = readSaved();
    $('savedList').innerHTML = a.map(function(r, i){
      var sty = '';
      if (r.s && DATA[r.s.cat]) DATA[r.s.cat].styles.forEach(function(x){ if (x.id === r.s.styleId) sty = x.name; });
      return '<li><div><b>' + esc(r.name) + '</b><span>' + esc(sty) + '</span></div>' +
        '<button type="button" class="btn sm ghost" data-load="' + i + '">Load</button>' +
        '<button type="button" class="btn sm ghost" data-del="' + i + '">Delete</button></li>';
    }).join('');
    $('savedNote').textContent = !storeOK ? 'Saving is not available in this view, so recipes will not be kept.' :
      (a.length ? 'Saved in this browser only.' : 'Save a formula to find it here next time. Recipes stay in this browser only.');
  }
  $('saveRec').addEventListener('click', function(){
    var snap = {};
    SAVE_KEYS.forEach(function(k){ snap[k] = state[k]; });
    var name = $('recName').value.trim() || currentStyle().name;
    var a = readSaved();
    a.unshift({ name:name.slice(0, 40), ts:Date.now(), s:snap });
    writeSaved(a.slice(0, 30));
    $('recName').value = '';
    renderSaved();
  });
  $('savedList').addEventListener('click', function(e){
    var b = e.target.closest('button');
    if (!b) return;
    var a = readSaved();
    if (b.hasAttribute('data-del')){
      a.splice(Number(b.getAttribute('data-del')), 1);
      writeSaved(a); renderSaved();
    } else if (b.hasAttribute('data-load')){
      var r = a[Number(b.getAttribute('data-load'))];
      if (!r || !r.s || !DATA[r.s.cat]) return;
      var ok = DATA[r.s.cat].styles.some(function(x){ return x.id === r.s.styleId; });
      if (!ok) return;
      SAVE_KEYS.forEach(function(k){ if (r.s[k] !== undefined) state[k] = r.s[k]; });
      if (state.cat !== 'sourdough') state.page = 'recipe';
      renderAll();
    }
  });

  /* extra controls */
  ['scaleBy','incl','starterType','vessel','sdMode','planMode','friction','feedRatio'].forEach(function(id){
    $(id).addEventListener('change', function(){
      var v = $(id).value;
      if (id === 'friction' || id === 'feedRatio') v = Number(v);
      state[id] = v;
      if (id === 'incl') state.inclPct = v === 'none' ? 0 : INCL[v].pct;
      if (id === 'starterType') state.starterHyd = STARTER_TYPES[v].hyd;
      syncControls();
      updateResults();
    });
  });
  $('planTime').addEventListener('input', function(){
    if ($('planTime').value) { state.planTime = $('planTime').value; updateResults(); }
  });
  $('useVessel').addEventListener('click', function(){
    VESSELS.forEach(function(v){
      if (v.id === state.vessel && v.g){ state.weight = v.g; state.pieces = 1; state.scaleBy = 'dough'; }
    });
    syncControls();
    updateResults();
  });
  $('unitSwitch').addEventListener('click', function(e){
    var b = e.target.closest('button[data-unit]');
    if (!b) return;
    state.units = b.getAttribute('data-unit');
    try { localStorage.setItem('dough-units', state.units); } catch (e2) {}
    renderAll();
  });

  var ACC_DESC = {
    'Bake-day timeline':'Clock times from feeding the starter to cutting the loaf',
    'Feed your starter':'Seed, flour and water for the feed or levain build',
    'Water temperature':'Water to hit your target dough temperature',
    'Is it ready?':'Checks for the starter, bulk, proof and bake',
    'Troubleshooting':'Common problems, causes and fixes'
  };
  Array.prototype.forEach.call(document.querySelectorAll('#sdTools .card'), function(card, i){
    var h3 = card.querySelector('h3');
    var title = h3.textContent;
    var body = document.createElement('div');
    body.className = 'acc-b';
    body.id = 'acc-' + i;
    while (h3.nextSibling) body.appendChild(h3.nextSibling);
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'acc-h';
    btn.setAttribute('aria-controls', body.id);
    btn.innerHTML = '<span class="acch">' + icon(ACC_ICON[title], 'ic ic-md') + '<span><b>' + title + '</b><small>' + (ACC_DESC[title] || '') + '</small></span></span><span class="chev" aria-hidden="true"></span>';
    var open = i === 0;
    btn.setAttribute('aria-expanded', String(open));
    body.hidden = !open;
    card.replaceChild(btn, h3);
    card.appendChild(body);
    btn.addEventListener('click', function(){
      var now = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(now));
      body.hidden = !now;
    });
  });

  $('notes').addEventListener('click', function(e){
    var b = e.target.closest('button[data-method]');
    if (b) pickMethod(b.getAttribute('data-method'));
  });
  $('methodSel').addEventListener('change', function(){ pickMethod($('methodSel').value); });


  /* ---- starter guide ---- */
  var SG_FLOUR = { white:'Bread flour', whole:'Whole wheat flour', rye:'Rye flour' };
  var SG_STEPS = [
    { icon:'jar', title:'Gather supplies', label:'Before you start', dates:null,
      todo:['Choose a clear glass jar of 500–750 ml so you can see the bubbles. A loose lid or a cloth is fine.','Weigh everything with a kitchen scale. Cups are too inconsistent for a starter.','Buy whole wheat or rye flour for the first days. They carry more wild yeast and bacteria. Bread flour works for later feeds.','Use lukewarm water, about 25–30 °C. Tap water is usually fine. If it smells strongly of chlorine, leave it out for 30 minutes first.','Find a spot that stays at 24–27 °C, such as a switched-off oven with the light on.'],
      amt:null, see:'Nothing yet. This step is only setup.', ok:'Put a rubber band or a piece of tape around the jar. You will use it to mark the level at every step.' },
    { icon:'bowl', title:'Mix', label:'Day 1', dates:[0,0],
      todo:['Put the flour and water in the jar.','Stir hard until no dry flour is left and scrape down the sides.','Mark the level with the rubber band.','Cover loosely and leave at 24–27 °C for 24 hours.'],
      amt:[['F',50],['Water',50]], see:'A thick, pasty batter. Not much happens yet.', ok:'No bubbles on day one is completely normal.' },
    { icon:'clock', title:'Rest and check', label:'Day 2', dates:[1,1],
      todo:['Stir the mixture and look for bubbles, a small rise or a sour smell.','If you see activity, feed it as on day 3. If not, stir, cover and wait another day.','Do not feed more often to speed it up.'],
      amt:null, see:'A few small bubbles and a sour, yeasty or even odd smell.', ok:'Strange smells and a quick burst of bubbles in the first days are normal. They are not your final starter and usually calm down.' },
    { icon:'wheat', title:'First feed', label:'Day 3', dates:[2,2],
      todo:['Keep 50 g of the mixture and throw away the rest.','Add fresh flour and lukewarm water. Stir well.','Mark the level, cover loosely and leave for 24 hours.'],
      amt:[['Keep',50],['F',50],['Water',50]], see:'It may rise a little and smell sour or fruity.', ok:'It can seem to die at this point. Keep feeding and the activity comes back.' },
    { icon:'sun', title:'Daily feed', label:'Days 4–5', dates:[3,4],
      todo:['Feed every 24 hours: keep 50 g, discard the rest, add flour and water.','You can switch to bread flour now, or keep the same flour.','Mark the level before each feed and note how far it rises.'],
      amt:[['Keep',50],['F',50],['Water',50]], see:'More bubbles, a rise of about 50% some hours after feeding and a pleasant sour smell.', ok:'Use the discard for pancakes or crackers instead of binning it.' },
    { icon:'thermo', title:'Faster feeds', label:'Days 6–7', dates:[5,6],
      todo:['If it rises reliably, feed every 12 hours: keep 50 g, discard the rest, add flour and water.','If it is still slow, stay on one feed a day and be patient. Cool rooms add days.','Keep it at 24–27 °C. Each 5 °C colder can double the time.'],
      amt:[['Keep',50],['F',50],['Water',50]], see:'A clear rise, a domed top, bubbles through the jar and a yoghurt-like, sweet-sour smell.', ok:'A layer of dark liquid on top means it is hungry. Pour it off or stir it in and feed sooner.' },
    { icon:'check', title:'Is it ready?', label:'From day 8', dates:[7,7],
      todo:['Feed it, mark the level and watch for 4–8 hours.','It is ready when it doubles within 4–8 hours of feeding, has a domed top and bubbles throughout, and does this for 2–3 days in a row.','Until then keep feeding. Many starters need 10–14 days and some take longer in winter.','Bake with it at its peak: doubled, domed and just before it starts to dip.'],
      amt:null, see:'Doubled, domed and bubbly, with a sweet and tangy smell.', ok:'Pink or orange streaks, or fuzzy mould on top, mean you should throw it away and start again.' },
    { icon:'snow', title:'Keep it going', label:'After it is ready', dates:null,
      todo:['For regular baking, keep it on the counter and feed it every 12–24 hours.','For weekly baking, keep it in the fridge and feed it once a week.','Before a bake, take it out and feed it once or twice, 4–12 hours ahead, until bubbly. Use the Sourdough Planner to time it.','Keep a little extra for baking and share some with a friend.'],
      amt:[['Starter from the fridge',10],['F',50],['Water',50]], see:'A starter that peaks in 4–8 hours after a feed.', ok:'A neglected starter nearly always revives after two or three feeds.' }
  ];
  var sg = { start:'', step:0, done:[], flour:'whole' };
  function isoDate(d){ return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }
  try {
    var rawSg = JSON.parse(localStorage.getItem('dough-starter') || 'null');
    if (rawSg && typeof rawSg === 'object'){
      if (/^\d{4}-\d{2}-\d{2}$/.test(rawSg.start || '')) sg.start = rawSg.start;
      if (typeof rawSg.step === 'number' && rawSg.step >= 0 && rawSg.step < SG_STEPS.length) sg.step = rawSg.step;
      if (Array.isArray(rawSg.done)) sg.done = rawSg.done.slice(0, SG_STEPS.length).map(Boolean);
      if (SG_FLOUR[rawSg.flour]) sg.flour = rawSg.flour;
    }
  } catch (e1) {}
  if (!sg.start) sg.start = isoDate(new Date());
  while (sg.done.length < SG_STEPS.length) sg.done.push(false);
  $('sgStart').value = sg.start;
  $('sgFlour').value = sg.flour;
  function saveSg(){ try { localStorage.setItem('dough-starter', JSON.stringify(sg)); } catch (e2) {} }
  function sgBase(){ var p = sg.start.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); }
  function sgDate(off){
    var b = sgBase();
    return new Date(b.getFullYear(), b.getMonth(), b.getDate() + off).toLocaleDateString(undefined, { weekday:'short', day:'numeric', month:'short' });
  }
  function sgDayIndex(){
    var n = new Date();
    return Math.round((new Date(n.getFullYear(), n.getMonth(), n.getDate()) - sgBase())/86400000);
  }
  function sgWhen(st){
    if (!st.dates) return st.label;
    var a = st.dates[0], b = st.dates[1];
    return st.label + ' · ' + (a === b ? sgDate(a) : sgDate(a) + ' – ' + sgDate(b));
  }
  function renderGuide(){
    var idx = sgDayIndex(), cur = -1;
    SG_STEPS.forEach(function(st, i){ if (st.dates && idx >= st.dates[0] && idx <= st.dates[1]) cur = i; });
    if (idx >= 7) cur = 6;
    var done = sg.done.filter(Boolean).length, total = SG_STEPS.length;
    $('sgProgress').innerHTML = '<div class="pbar" role="progressbar" aria-valuemin="0" aria-valuemax="' + total + '" aria-valuenow="' + done + '"><i style="width:' + Math.round(done/total*100) + '%"></i></div><p class="hint">' + done + ' of ' + total + ' steps done</p>';
    $('sgToday').innerHTML = '<div class="strip"><p>' +
      (idx < 0 ? 'Your start date is in ' + (-idx) + (idx === -1 ? ' day.' : ' days.') : 'Today is day ' + (idx + 1) + (cur >= 0 ? '. Current step: <b>' + SG_STEPS[cur].title + '</b>.' : '.')) + '</p>' +
      (cur >= 0 && cur !== sg.step ? '<button type="button" class="btn sm ghost" data-go="' + cur + '">Go to this step</button>' : '') + '</div>';
    $('sgMenu').innerHTML = SG_STEPS.map(function(st, i){
      return '<button type="button" class="chip" data-i="' + i + '" aria-pressed="' + (i === sg.step) + '" data-done="' + sg.done[i] + '">' +
        '<span class="thumb">' + icon(st.icon) + '</span><span class="txt"><span class="n">' + st.title + '</span><span class="m">' + (st.dates ? st.label + ' · ' + sgDate(st.dates[0]) : st.label) + '</span></span></button>';
    }).join('');
    var st = SG_STEPS[sg.step], i = sg.step;
    var amt = '';
    if (st.amt){
      amt = '<div><h4>Amounts</h4><dl class="kv">' + st.amt.map(function(a){
        var name = a[0] === 'F' ? SG_FLOUR[sg.flour] : a[0];
        if (a[0] === 'F' && i >= 3) name = 'Flour (bread flour or the same)';
        return '<dt>' + name + '</dt><dd>' + fmtW(a[1]) + '</dd>';
      }).join('') + (i >= 3 && i <= 5 ? '<dt>Discard</dt><dd>the rest</dd>' : '') + '</dl></div>';
    }
    $('sgDetail').innerHTML = '<div class="card"><div class="sghead">' + icon(st.icon, 'ic ic-lg') + '<div><p class="eyebrow">' + sgWhen(st) + '</p><h3 class="mh">' + st.title + '</h3></div></div>' +
      '<div class="cols sgcols" style="margin-top:18px"><div class="sgbody"><div><h4>What to do</h4><ol>' + st.todo.map(function(t){ return '<li>' + L(t) + '</li>'; }).join('') + '</ol></div></div>' +
      '<div class="sgbody">' + amt + '<div><h4>What you should see</h4><p>' + L(st.see) + '</p></div><div><h4>Good to know</h4><p>' + L(st.ok) + '</p></div></div></div>' +
      '<div class="sgact">' + (i > 0 ? '<button type="button" class="btn ghost" data-act="prev">Back</button>' : '') +
      '<button type="button" class="btn ' + (sg.done[i] ? 'ghost' : '') + '" data-act="done">' + (sg.done[i] ? 'Done. Undo' : 'Mark as done') + '</button>' +
      (i < total - 1 ? '<button type="button" class="btn ghost" data-act="next">Next step</button>' : '') + '</div></div>';
  }
  $('sgMenu').addEventListener('click', function(e){
    var b = e.target.closest('button[data-i]');
    if (!b) return;
    sg.step = Number(b.getAttribute('data-i'));
    saveSg(); renderGuide();
  });
  $('sgToday').addEventListener('click', function(e){
    var b = e.target.closest('button[data-go]');
    if (!b) return;
    sg.step = Number(b.getAttribute('data-go'));
    saveSg(); renderGuide();
  });
  $('sgDetail').addEventListener('click', function(e){
    var b = e.target.closest('button[data-act]');
    if (!b) return;
    var act = b.getAttribute('data-act');
    if (act === 'done') sg.done[sg.step] = !sg.done[sg.step];
    else if (act === 'next' && sg.step < SG_STEPS.length - 1) sg.step++;
    else if (act === 'prev' && sg.step > 0) sg.step--;
    saveSg(); renderGuide();
  });
  $('sgStart').addEventListener('change', function(){
    if (/^\d{4}-\d{2}-\d{2}$/.test($('sgStart').value)){ sg.start = $('sgStart').value; saveSg(); renderGuide(); }
  });
  $('sgFlour').addEventListener('change', function(){
    sg.flour = $('sgFlour').value;
    saveSg(); renderPickers(); renderGuide();
  });
  $('sgReset').addEventListener('click', function(){
    sg.start = isoDate(new Date()); sg.step = 0; sg.done = SG_STEPS.map(function(){ return false; });
    $('sgStart').value = sg.start;
    saveSg(); renderGuide();
  });


  /* ---- fermentation basics ---- */
  var FER = [
    { icon:'bowl', title:'Direct dough', tag:'Mixed in one go',
      facts:[['What it is','Everything goes into the bowl together and rises once or twice before baking. No pre-ferment.'],['Good for','Sandwich loaves, quick pizza and everyday bread.'],['Time','1.5–4 hours at room temperature.'],['Flavour','Clean and mild. More yeast makes a quicker, plainer loaf.']],
      tryIt:{ hours:3, temp:24 } },
    { icon:'clock', title:'Bulk fermentation', tag:'First rise',
      facts:[['What it is','The first rise, after mixing and before shaping. The yeast or starter makes gas, the dough gets stronger with folds and flavour starts to build.'],['Time','Yeast: 1–3 hours. Sourdough: 4–12 hours, depending on temperature and how much starter you use.'],['How to tell it is done','Yeast dough has about doubled. Sourdough is up 50–75%, domed, jiggly and full of bubbles.']] },
    { icon:'basket', title:'Final proof', tag:'Last rise after shaping',
      facts:[['What it is','The last rise, once the dough is shaped and sitting in its banneton, tin or tray.'],['Time','30–90 minutes warm, or 8–16 hours in the fridge.'],['How to tell it is ready','Poke it with a floured finger. It should spring back slowly and only partly. Fast spring back needs more time. A dent that stays means bake right away.']] },
    { icon:'snow', title:'Cold fermentation', tag:'Slow rise in the fridge',
      facts:[['What it is','Letting the dough ferment slowly at about 3–5 °C, after mixing, after shaping, or both. Also called retarding.'],['Time','12–72 hours.'],['Why do it','More flavour, better browning and blistering, easier scoring, and a baking time that fits around your day. It needs much less yeast, so set a long time and a low temperature in the calculator.']],
      tryIt:{ hours:24, temp:4 } },
    { icon:'thermo', title:'Temperature and time', tag:'Speed and heat',
      facts:[['The rule','Fermentation speed depends on temperature. Very roughly, every 8–10 °C warmer halves the time.'],['Working range','24–26 °C is comfortable. Above 30 °C dough ferments fast and can taste flat. Below 5 °C it almost stops.'],['In this app','Move the Dough temperature and time sliders and the yeast or starter amount changes to match.']] },
    { icon:'jar-white', title:'Poolish', tag:'Wet pre-ferment',
      facts:[['What it is','A runny pre-ferment of equal weights of flour and water with a pinch of yeast, made ahead and then mixed into the dough.'],['Good for','Baguettes, ciabatta and breads with an open, light crumb.'],['Time','8–16 hours at room temperature.'],['Flavour','Mild, nutty and slightly sweet.']] },
    { icon:'jar-stiff', title:'Biga', tag:'Stiff pre-ferment',
      facts:[['What it is','A stiff Italian pre-ferment, about 50–60% hydration, made with a little yeast.'],['Good for','Ciabatta, pizza and rustic loaves.'],['Time','12–18 hours at 16–18 °C.'],['Flavour','More complex and a little sour. It also makes the dough stronger.']] },
    { icon:'ciabatta', title:'Old dough', tag:'Saved piece of dough',
      facts:[['What it is','A piece of yesterday’s dough kept back and mixed into the next batch. The French call it pâte fermentée.'],['Good for','Baguettes, pizza and any bread that needs more flavour.'],['Time','Made the day before, about 12–24 hours, often kept in the fridge.'],['Flavour','A deeper, more bread-like taste with no extra work.']] },
    { icon:'jar', title:'Sourdough levain', tag:'Wild yeast and bacteria',
      facts:[['What it is','Wild yeast and lactic acid bacteria from a starter do the fermenting instead of packet yeast.'],['Good for','Sourdough loaves and pizza.'],['Time','4–12 hours of bulk, often plus a night in the fridge.'],['Flavour','Tangy. Warm, wet fermentation gives more lactic acid, which tastes like yoghurt. Cool, stiffer fermentation gives more acetic acid, which tastes sharper, like vinegar.']] }
  ];
  var fer = { open:false, i:0 };
  function renderFer(){
    $('ferMenu').innerHTML = FER.map(function(f, i){
      return '<button type="button" class="chip" data-f="' + i + '" aria-pressed="' + (i === fer.i) + '"><span class="thumb">' + icon(f.icon) + '</span><span class="txt"><span class="n">' + f.title + '</span><span class="m">' + f.tag + '</span></span></button>';
    }).join('');
    var f = FER[fer.i];
    $('ferDetail').innerHTML = '<div class="sghead">' + icon(f.icon, 'ic ic-lg') + '<div><h3 class="mh">' + f.title + '</h3></div></div>' +
      '<div class="sgbody" style="margin-top:14px">' + f.facts.map(function(x){ return '<div><h4>' + x[0] + '</h4><p>' + L(x[1]) + '</p></div>'; }).join('') + '</div>' +
      (f.tryIt ? '<div class="sgact"><button type="button" class="btn" data-try="1">Apply to the calculator</button></div>' : '');
  }
  $('ferBtn').addEventListener('click', function(){
    fer.open = !fer.open;
    $('ferBtn').setAttribute('aria-expanded', String(fer.open));
    $('ferBody').hidden = !fer.open;
    if (fer.open) renderFer();
  });
  $('ferMenu').addEventListener('click', function(e){
    var b = e.target.closest('button[data-f]');
    if (!b) return;
    fer.i = Number(b.getAttribute('data-f'));
    renderFer();
  });
  $('ferDetail').addEventListener('click', function(e){
    var b = e.target.closest('button[data-try]');
    var f = FER[fer.i];
    if (!b || !f.tryIt) return;
    state.hours = f.tryIt.hours;
    state.temp = f.tryIt.temp;
    state.page = 'recipe';
    renderAll();
    try { window.scrollTo(0, 0); } catch (e3) {}
  });

  $('pageTabs').addEventListener('click', function(e){
    var b = e.target.closest('button[data-page]');
    if (!b) return;
    state.page = b.getAttribute('data-page');
    if (state.page === 'tools'){
      if (state.cat !== 'sourdough'){
        state.cat = 'sourdough';
        state.styleId = styleList()[0].id;
        applyPreset();
      }
      state.leaven = 'starter';
    }
    renderAll();
  });
  $('editFormula').addEventListener('click', function(){ state.page = 'recipe'; renderAll(); });
  $('bulkH').addEventListener('input', function(){
    var v = parseFloat($('bulkH').value);
    if (!isFinite(v)) return;
    state.hours = clamp(v, 1, 72);
    $('hours').value = state.hours;
    updateResults();
  });
  $('doughT').addEventListener('input', function(){
    var v = parseFloat($('doughT').value);
    if (!isFinite(v)) return;
    state.temp = clamp(Math.round(toBase('t', v)), 2, 32);
    $('temp').value = state.temp;
    updateResults();
  });
  ['bulkH','doughT'].forEach(function(id){
    $(id).addEventListener('blur', function(){ syncControls(); });
  });

  applyPreset();
  renderAll();
})();
</script>


</body></html>
